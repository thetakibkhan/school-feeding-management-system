#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PHP_ROOT="${PROTTYASHI_PHP_ROOT:-/tmp/prottyashi-php/root}"
PHP_INI="${PROTTYASHI_PHP_INI:-/tmp/prottyashi-php/php.ini}"

cd "$APP_ROOT/public"
exec env PHPRC="$PHP_INI" \
    LD_LIBRARY_PATH="$PHP_ROOT/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    "$PHP_ROOT/usr/bin/php8.3" \
    -S "${APP_HOST:-127.0.0.1}:${APP_PORT:-8000}" \
    ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php
